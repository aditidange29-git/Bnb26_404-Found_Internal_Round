# GEMINI_API_KEY: Used only when running inside Google AI Studio.
# This project currently runs entirely client-side using the Browser WebCrypto API
# for cryptographic operations. No Gemini AI calls are made in the current implementation.
# You do NOT need to set this to run the app locally — it is here as a template
# placeholder from the original AI Studio export.
# If you extend the app with Gemini AI features, set this to your API key.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# APP_URL: The public URL where this app is hosted (used for self-referential links).
# Leave empty for local development — only needed for production deployments.
APP_URL="YOUR_APP_URL_HERE"
